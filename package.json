{
  "name": "suite-kit",
  "version": "0.2.0",
  "description": "Gemeinsame Konto-Föderation für die eigenständigen Tools der App-Suite (rsvp-app, abstimmungstool, ...)",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "suite-keygen": "./bin/suite-keygen.js"
  },
  "files": [
    "dist/src",
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/",
    "prepare": "tsc"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
