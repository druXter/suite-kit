{
  "name": "suite-kit",
  "version": "0.4.0",
  "description": "Gemeinsame Grundlage der eigenständigen Tools der App-Suite: Konto-Föderation und Oberfläche (rsvp-app, abstimmungstool, seating, zeitplan, schichten)",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./theme.css": {
      "style": "./ui/theme.css",
      "default": "./ui/theme.css"
    }
  },
  "bin": {
    "suite-keygen": "./bin/suite-keygen.js"
  },
  "files": [
    "dist/src",
    "dist/ui",
    "dist/web",
    "ui/theme.css",
    "bin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/",
    "prepare": "tsc"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "typescript": "^5"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
